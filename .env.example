GROQ_API_KEY=your_groq_api_key_here
# Daftar model fallback, dipisahkan koma. Urutan = prioritas tertinggi ke terendah.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b
GROQ_BASE_URL=  # Opsional: OmniRoute/OpenRouter endpoint, biarkan kosong jika pakai Groq langsung
TEMP_FOLDER=uploads
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

# Security
API_TOKEN=your_super_secret_token_here
DOCS_USERNAME=admin
DOCS_PASSWORD=admin
