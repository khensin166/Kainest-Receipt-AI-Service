GROQ_API_KEY=your_groq_api_key_here
# Daftar model fallback, dipisahkan koma. Urutan = prioritas tertinggi ke terendah.
GROQ_MODELS=llama-3.1-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768
GROQ_BASE_URL=  # Biarkan kosong jika pakai Groq langsung
TEMP_FOLDER=uploads
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

# Security
API_TOKEN=your_super_secret_token_here
DOCS_USERNAME=admin
DOCS_PASSWORD=admin
